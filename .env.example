# 复制为 .env 后填写真实值；.env 不要提交到版本库

# ── 大模型（OpenAI 兼容网关）──────────────────────────
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# Qwen3 系默认开启思考模式，会显著增加延迟；演示/生产建议 false
DASHSCOPE_ENABLE_THINKING=false

# ── MySQL（两个库）────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your-password
DB_NAME=pig_diag_v2

# 监测模块使用独立数据库（默认 pig_cough_dataset）
MONITOR_DB_NAME=pig_cough_dataset

# 监测 API 鉴权（留空=不鉴权；生产环境务必设置强随机串）
MONITOR_API_TOKEN=
