# 依赖文件夹（体积巨大，必须忽略）
node_modules/
Data/*
data/*
__pycache__/
!data/kg/
!data/rag/

# 构建输出目录（由源码生成，不需要提交）
dist/
build/
out/

# 环境变量文件（包含敏感信息）
.env
.env.local
.env.production

# 操作系统生成的垃圾文件
.DS_Store
Thumbs.db

# IDE 配置文件
.vscode/
.idea/
*.swp
*.swo

# 日志文件
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 但保留示例配置文件（取反）
!.env.example
#训练数据
*.wav
*.aup3